# ============================================================================
# Botify Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# Main Supabase Account
# Used for: Users, Roles, Bots, Marketplace, WhatsApp, Authentication
# Source: https://app.supabase.com → Settings → API Keys
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-main-project.supabase.co
SUPABASE_SERVICE_KEY=eyJobXV0h... # service_role key (never share publicly)

# ─────────────────────────────────────────────────────────────────────────
# Email Forwarding Supabase Account (SEPARATE ACCOUNT)
# Used exclusively for Email Forwarding Bot feature
# This is a DIFFERENT Supabase project from the main account above
# 
# Benefits of separation:
# - No conflicts with existing features
# - Independent scaling and backups
# - Better security and data isolation
# - Easier to disable/modify without affecting core features
# 
# Leave empty if Email Forwarding is not being used (feature will be disabled)
# ─────────────────────────────────────────────────────────────────────────
EMAIL_FORWARDING_SUPABASE_URL=https://your-email-forwarding-project.supabase.co
EMAIL_FORWARDING_SUPABASE_SERVICE_KEY=eyJobXV0h... # service_role key for email forwarding account

# ─────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-generate-a-strong-random-string

# Optional: Password encryption for email forwarding credentials
ENCRYPTION_KEY=your-32-char-hex-key-for-aes-256

# ─────────────────────────────────────────────────────────────────────────
# Email (Nodemailer)
# Used for: Password reset emails, notifications
# ─────────────────────────────────────────────────────────────────────────
NODEMAILER_EMAIL=your-email@gmail.com
NODEMAILER_PASSWORD=your-app-specific-password # Gmail: Create at myaccount.google.com/apppasswords

# ─────────────────────────────────────────────────────────────────────────
# Telegram Bot (Optional)
# ─────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ─────────────────────────────────────────────────────────────────────────
# Database (Local PostgreSQL)
# Used only if running without Supabase (legacy setup)
# ─────────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=botify
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# ─────────────────────────────────────────────────────────────────────────
# Email Forwarding Scheduler
# ─────────────────────────────────────────────────────────────────────────
EMAIL_FORWARDING_CHECK_INTERVAL=5  # Minutes between email scans (default: 5 min)

# ─────────────────────────────────────────────────────────────────────────
# WhatsApp Integration
# .wwebjs_auth/ directory auto-created for session management
# ─────────────────────────────────────────────────────────────────────────
# No additional env vars needed – uses LocalAuth strategy
